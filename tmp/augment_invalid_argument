 */\nimport { AppTheme } from '../utils/AppTheme';\nimport { Logger } from '../utils/Logger';\nimport { ThemeManager } from '../utils/ThemeManager';\nimport { CalculatorPage } from './CalculatorPage';\nimport { HistoryPage } from './HistoryPage';\nimport { AdvancedMathPage } from './AdvancedMathPage';\nimport { GraphPage } from './GraphPage';\nimport { ImageOCRPage } from './ImageOCRPage';\nimport { SettingsPage } from './SettingsPage';\nimport { router } from '@kit.ArkUI';\nimport { promptAction } from '@kit.ArkUI';\nimport { BusinessError } from '@kit.BasicServicesKit';\n\n@Entry\n@Component\nstruct MainPage {\n  @State currentIndex: number = 0;\n  @StorageLink('currentTheme') currentTheme: string = 'light';\n  private themeManager: ThemeManager = ThemeManager.getInstance();\n\n  aboutToAppear() {\n    Logger.info('MainPage loaded');\n    // 初始化主题\n    AppStorage.setOrCreate('currentTheme', this.themeManager.getCurrentTheme());\n  }\n\n  build() {\n    Column() {\n      // 内容区域\n      Tabs({ index: this.currentIndex }) {\n        TabContent() {\n          CalculatorPage()\n        }\n        .tabBar(this.buildTabBarItem('Calculator', 0, 'app.media.startIcon'))\n\n        TabContent() {\n          HistoryPage()\n        }\n        .tabBar(this.buildTabBarItem('History', 1, ''))\n\n        TabContent() {\n          AdvancedMathPage()\n        }\n        .tabBar(this.buildTabBarItem('Converter', 2, ''))\n\n        TabContent() {\n          this.buildToolsPage()\n        }\n        .tabBar(this.buildTabBarItem('Tools', 3, ''))\n\n        TabContent() {\n          SettingsPage()\n        }\n        .tabBar(this.buildTabBarItem('Settings', 4, ''))\n      }\n      .barMode(BarMode.Fixed)\n      .barPosition(BarPosition.End)\n      .onChange((index: number) => {\n        this.currentIndex = index;\n        Logger.info(`Tab switched to: ${index}`);\n      })\n      .layoutWeight(1)\n      .vertical(false)\n      .scrollable(false)\n      .animationDuration(200)\n      .backgroundColor(AppTheme.getBackgroundColor(this.currentTheme === 'dark'))\n    }\n    .width('100%')\n    .height('100%')\n    .backgroundColor(AppTheme.getBackgroundColor(this.currentTheme === 'dark'))\n  }\n\n  /**\n   * 构建底部导航栏项\n   */\n  @Builder buildTabBarItem(title: string, index: number, iconResource: string) {\n    Column() {\n      // 图标和文字垂直布局\n      Column() {\n        // 根据不同的标签显示不同的图标（使用Unicode字符）\n        if (index === 0) {\n          // Calculator - 计算器图标\n          Text('⊞')\n            .fontSize(22)\n            .fontWeight(FontWeight.Normal)\n            .fontColor(this.currentIndex === index ? AppTheme.PRIMARY_COLOR : AppTheme.getTertiaryTextColor(this.currentTheme === 'dark'))\n        } else if (index === 1) {\n          // History - 时钟图标\n          Text('🕐')\n            .fontSize(22)\n            .fontColor(this.currentIndex === index ? AppTheme.PRIMARY_COLOR : AppTheme.getTertiaryTextColor(this.currentTheme === 'dark'))\n        } else if (index === 2) {\n          // Converter - 转换图标\n          Text('⇄')\n            .fontSize(22)\n            .fontWeight(FontWeight.Bold)\n            .fontColor(this.currentIndex === index ? AppTheme.PRIMARY_COLOR : AppTheme.getTertiaryTextColor(this.currentTheme === 'dark'))\n        } else if (index === 3) {\n          // Tools - 工具图标\n          Text('🔧')\n            .fontSize(22)\n            .fontColor(this.currentIndex === index ? AppTheme.PRIMARY_COLOR : AppTheme.getTertiaryTextColor(this.currentTheme === 'dark'))\n        } else if (index === 4) {\n          // Settings - 齿轮图标\n          Text('⚙')\n            .fontSize(22)\n            .fontColor(this.currentIndex === index ? AppTheme.PRIMARY_COLOR : AppTheme.getTertiaryTextColor(this.currentTheme === 'dark'))\n        }\n        \n        Text(title)\n          .fontSize(AppTheme.FONT_SIZE_MINI)\n          .fontColor(this.currentIndex === index ? AppTheme.PRIMARY_COLOR : AppTheme.getTertiaryTextColor(this.currentTheme === 'dark'))\n          .margin({ top: AppTheme.SPACING_MINI })\n      }\n      .justifyContent(FlexAlign.Center)\n      .layoutWeight(1)\n      \n      // 底部选中指示器\n      Row()\n        .width(40)\n        .height(3)\n        .backgroundColor(this.currentIndex === index ? AppTheme.PRIMARY_COLOR : 'transparent')\n        .borderRadius(1.5)\n        .margin({ top: 4 })\n    }\n    .width('100%')\n    .height(56)\n    .justifyContent(FlexAlign.Center)\n    .alignItems(HorizontalAlign.Center)\n  }\n\n  /**\n   * Tools 页面\n   */\n  @Builder buildToolsPage() {\n    Column() {\n      // 标题\n      Row() {\n        Text('工具')\n          .fontSize(AppTheme.FONT_SIZE_LARGE)\n          .fontWeight(FontWeight.Bold)\n          .fontColor(AppTheme.getPrimaryTextColor(this.currentTheme === 'dark'))\n      }\n      .width('100%')\n      .height(56)\n      .padding({ left: AppTheme.SPACING_LARGE })\n      .backgroundColor(AppTheme.getCardBackground(this.currentTheme === 'dark'))\n      .justifyContent(FlexAlign.Start)\n\n      Scroll() {\n        Column() {\n          // 图像识别工具卡片\n          this.buildToolCard(\n            '图像识别',\n            '拍照或上传图片识别数学公式',\n            '📷',\n            () => {\n              router.pushUrl({\n                url: 'pages/ImageOCRPage'\n              }, router.RouterMode.Standard).catch((err: BusinessError) => {\n                Logger.error('Failed to navigate to ImageOCRPage', err);\n              });\n            }\n          );\n\n          // 单位转换工具卡片\n          this.buildToolCard(\n            '单位转换',\n            '长度、重量、温度等单位转换',\n            '🔄',\n            () => {\n              router.pushUrl({\n                url: 'pages/UnitConversionPage'\n              }, router.RouterMode.Standard).catch((err: BusinessError) => {\n                Logger.error('Failed to navigate to UnitConversionPage', err);\n              });\n            }\n          );\n        }\n        .width('100%')\n        .padding({ left: 16, right: 16, top: 16 })\n      }\n      .layoutWeight(1)\n      .backgroundColor('#F5F5F5')\n    }\n    .width('100%')\n    .height('100%')\n    .backgroundColor('#F5F5F5')\n  }\n\n  /**\n   * 工具卡片\n   */\n  @Builder buildToolCard(title: string, description: string, icon: string, onClick: () => void) {\n    Column() {\n      Row() {\n        // 图标\n        Text(icon)\n          .fontSize(40)\n          .margin({ right: AppTheme.SPACING_MEDIUM })\n\n        // 文字信息\n        Column() {\n          Text(title)\n            .fontSize(AppTheme.FONT_SIZE_SUBTITLE)\n            .fontWeight(FontWeight.Medium)\n            .fontColor(AppTheme.getPrimaryTextColor(this.currentTheme === 'dark'))\n            .width('100%')\n            .margin({ bottom: AppTheme.SPACING_MINI })\n\n          Text(description)\n            .fontSize(AppTheme.FONT_SIZE_MEDIUM)\n            .fontColor(AppTheme.getSecondaryTextColor(this.currentTheme === 'dark'))\n            .width('100%')\n        }\n        .layoutWeight(1)\n        .alignItems(HorizontalAlign.Start)\n\n        // 箭头\n        Text('›')\n          .fontSize(AppTheme.FONT_SIZE_LARGE)\n          .fontColor(AppTheme.TEXT_DISABLED)\n      }\n      .width('100%')\n      .padding(AppTheme.SPACING_MEDIUM)\n    }\n    .width('100%')\n    .backgroundColor(AppTheme.getCardBackground(this.currentTheme === 'dark'))\n    .borderRadius(AppTheme.BORDER_RADIUS_MEDIUM)\n    .margin({ bottom: AppTheme.SPACING_NORMAL })\n    .onClick(onClick)\n  }\n\n  /**\n   * 占位符页面\n   */\n  @Builder buildPlaceholder(title: string) {\n    Column() {\n      Text(`${title}功能`)\n        .fontSize(24)\n        .fontColor('#999')\n      \n      Text('开发中...')\n        .fontSize(16)\n        .fontColor('#ccc')\n        .margin({ top: 10 })\n    }\n    .width('100%')\n    .height('100%')\n    .justifyContent(FlexAlign.Center)\n    .backgroundColor('#fff')\n  }\n}\n\n\n```","tool_call_id":"tool_c383d011-f93e-4dbe-9163-b298737644d0","name":"read_file"},{"role":"assistant","content":"","tool_calls":[{"type":"function","id":"tool_23268154-d2f3-42a6-8b23-231272243781","index":0,"function":{"name":"read_file","arguments":"{\"target_file\":\"/Users/wangyiqiu/DevEcoStudioProjects/hello_my_worldMyApplication/entry/src/main/ets/pages/ImageOCRPage.ets\"}"}}]},{"role":"tool","content":"```\n/**\n * 图像识别页面\n * 支持拍照和相册导入识别数学公式\n */\nimport { Logger } from '../utils/Logger';\nimport { ToastHelper } from '../utils/ToastHelper';\nimport { OCRService, OCRResult } from '../services/OCRService';\nimport { LaTeXRenderer } from '../components/LaTeXRenderer';\nimport { camera } from '@kit.CameraKit';\nimport { picker } from '@kit.CoreFileKit';\nimport { photoAccessHelper } from '@kit.MediaLibraryKit';\nimport { BusinessError } from '@kit.BasicServicesKit';\nimport { router } from '@kit.ArkUI';\n\n@Entry\n@Component\nstruct ImageOCRPage {\n  @State hasImage: boolean = false;\n  @State recognizedLatex: string = '';\n  @State isProcessing: boolean = false;\n  @State imageUri: string = '';\n  @State showResult: boolean = false;\n  @StorageLink('calculatorInput') calculatorInput: string = '';\n  \n  private ocrService: OCRService = OCRService.getInstance();\n\n  aboutToAppear() {\n    Logger.info('ImageOCRPage loaded');\n    \n    // 检查是否从相机页面返回\n    const params = router.getParams() as Record<string, Object> | null;\n    if (params && params['fromCamera']) {\n      const imageUri = params['imageUri'] as string;\n      if (imageUri) {\n        Logger.info(`Received image from camera: ${imageUri}`);\n        this.imageUri = imageUri;\n        this.hasImage = true;\n        this.showResult = true;\n        this.isProcessing = true;\n        \n        // 延迟执行 OCR 识别\n        setTimeout(async () => {\n          await this.performOCR(imageUri);\n        }, 100);\n      }\n    }\n  }\n\n  build() {\n    Column() {\n      // 顶部标题栏\n      Row() {\n        // 返回按钮\n        Text('←')\n          .fontSize(24)\n          .fontColor('#333333')\n          .width(40)\n          .height(40)\n          .textAlign(TextAlign.Center)\n          .onClick(() => {\n            router.back();\n          })\n        \n        Text('图像识别')\n          .fontSize(20)\n          .fontWeight(FontWeight.Medium)\n          .fontColor('#333333')\n          .layoutWeight(1)\n          .textAlign(TextAlign.Center)\n        \n        // 右侧菜单按钮（占位）\n        Text('⋯')\n          .fontSize(24)\n          .fontColor('#333333')\n          .width(40)\n          .height(40)\n          .textAlign(TextAlign.Center)\n      }\n      .width('100%')\n      .height(56)\n      .padding({ left: 8, right: 8 })\n      .backgroundColor('#FFFFFF')\n      .justifyContent(FlexAlign.SpaceBetween)\n\n      Scroll() {\n        Column() {\n          // 主要提示区域\n          Column() {\n            // 相机图标\n            Text('📷')\n              .fontSize(80)\n              .margin({ bottom: 24 })\n\n            Text('Upload an image or take a photo to')\n              .fontSize(18)\n              .fontWeight(FontWeight.Medium)\n              .fontColor('#333333')\n              .textAlign(TextAlign.Center)\n              .margin({ bottom: 4 })\n\n            Text('recognize formulas')\n              .fontSize(18)\n              .fontWeight(FontWeight.Medium)\n              .fontColor('#333333')\n              .textAlign(TextAlign.Center)\n              .margin({ bottom: 16 })\n\n            Text('Get instant results from your camera or gallery.')\n              .fontSize(14)\n              .fontColor('#999999')\n              .textAlign(TextAlign.Center)\n          }\n          .width('100%')\n          .padding({ top: 60, bottom: 40, left: 20, right: 20 })\n          .backgroundColor('#F5F7FA')\n          .borderRadius(16)\n          .margin({ top: 20, left: 16, right: 16 })\n\n          // 操作按钮\n          Row() {\n            Button() {\n              Row() {\n                Text('📷')\n                  .fontSize(20)\n                  .margin({ right: 8 })\n                Text('拍照识别')\n                  .fontSize(16)\n                  .fontColor('#1890FF')\n              }\n            }\n            .width('48%')\n            .height(50)\n            .backgroundColor('#E6F4FF')\n            .borderRadius(12)\n            .onClick(() => {\n              this.takePhoto();\n            })\n\n            Button() {\n              Row() {\n                Text('🖼️')\n                  .fontSize(20)\n                  .margin({ right: 8 })\n                Text('从相册导入')\n                  .fontSize(16)\n                  .fontColor('#1890FF')\n              }\n            }\n            .width('48%')\n            .height(50)\n            .backgroundColor('#E6F4FF')\n            .borderRadius(12)\n            .onClick(() => {\n              this.selectFromAlbum();\n            })\n          }\n          .width('100%')\n          .padding({ left: 16, right: 16, top: 20 })\n          .justifyContent(FlexAlign.SpaceBetween)\n\n          // 示例图片区域（如果有图片）\n          if (this.hasImage && this.imageUri) {\n            Column() {\n              Image(this.imageUri)\n                .width('100%')\n                .height(200)\n                .objectFit(ImageFit.Contain)\n                .borderRadius(12)\n            }\n            .width('100%')\n            .padding({ left: 16, right: 16, top: 20 })\n          }\n\n          // 识别结果区域\n          if (this.showResult) {\n            Column() {\n              // 识别结果标题\n              Row() {\n                Text('识别结果:')\n                  .fontSize(18)\n                  .fontWeight(FontWeight.Medium)\n                  .fontColor('#333333')\n              }\n              .width('100%')\n              .margin({ bottom: 16 })\n              .justifyContent(FlexAlign.Start)\n\n              // 显示识别的公式\n              if (this.isProcessing) {\n                Column() {\n                  LoadingProgress()\n                    .width(40)\n                    .height(40)\n                    .margin({ bottom: 12 })\n                  Text('正在识别中...')\n                    .fontSize(14)\n                    .fontColor('#999999')\n                }\n                .width('100%')\n                .height(100)\n                .backgroundColor('#F5F5F5')\n                .borderRadius(12)\n                .justifyContent(FlexAlign.Center)\n              } else if (this.recognizedLatex) {\n                Column() {\n                  // 使用 LaTeX 渲染器显示公式\n                  LaTeXRenderer({ latex: this.recognizedLatex })\n                  \n                  // 显示原始 LaTeX 代码（可选）\n                  Text(this.recognizedLatex)\n                    .fontSize(12)\n                    .fontColor('#999999')\n                    .margin({ top: 12 })\n                    .width('100%')\n                    .textAlign(TextAlign.Center)\n                }\n                .width('100%')\n                .padding(16)\n                .backgroundColor('#F5F5F5')\n                .borderRadius(12)\n              } else {\n                Column() {\n                  Text('识别失败，请重试')\n                    .fontSize(14)\n                    .fontColor('#FF4D4F')\n                }\n                .width('100%')\n                .height(80)\n                .backgroundColor('#FFF1F0')\n                .borderRadius(12)\n                .justifyContent(FlexAlign.Center)\n              }\n\n              // 一键导入计算器按钮\n              if (this.recognizedLatex) {\n                Button('一键导入计算器')\n                  .fontSize(16)\n                  .width('100%')\n                  .height(48)\n                  .backgroundColor('#1890FF')\n                  .fontColor('#FFFFFF')\n                  .borderRadius(24)\n                  .margin({ top: 16 })\n                  .onClick(() => {\n                    this.importToCalculator();\n                  })\n              }\n            }\n            .width('100%')\n            .padding({ left: 16, right: 16, top: 24 })\n          }\n\n          // 底部占位\n          Column()\n            .height(100)\n        }\n        .width('100%')\n      }\n      .layoutWeight(1)\n      .backgroundColor('#FFFFFF')\n    }\n    .width('100%')\n    .height('100%')\n    .backgroundColor('#FFFFFF')\n  }\n\n  /**\n   * 拍照\n   */\n  async takePhoto() {\n    try {\n      Logger.info('Opening camera...');\n      \n      // 跳转到相机页面\n      router.pushUrl({\n        url: 'pages/CameraPage'\n      }, router.RouterMode.Standard).catch((err: BusinessError) => {\n        Logger.error('Failed to navigate to CameraPage', err);\n        ToastHelper.showError('打开相机失败');\n      });\n      \n    } catch (error) {\n      Logger.error('Failed to open camera', error);\n      ToastHelper.showError('打开相机失败');\n    }\n  }\n\n  /**\n   * 执行 OCR 识别\n   */\n  async performOCR(imageUri: string) {\n    try {\n      this.isProcessing = true;\n      \n      // 调用 OCR 服务识别\n      const result = await this.ocrService.recognizeFormula(imageUri);\n      \n      this.isProcessing = false;\n      \n      if (result.success) {\n        this.recognizedLatex = result.latex;\n        ToastHelper.showSuccess('识别成功！');\n        Logger.info(`OCR result: ${result.latex}`);\n      } else {\n        this.recognizedLatex = '';\n        ToastHelper.showError(result.error || '识别失败');\n      }\n    } catch (error) {\n      Logger.error('OCR recognition failed', error);\n      this.isProcessing = false;\n      this.recognizedLatex = '';\n      ToastHelper.showError('识别失败');\n    }\n  }\n\n  /**\n   * 从相册选择\n   */\n  async selectFromAlbum() {\n    try {\n      Logger.info('Selecting from album...');\n      \n      // 创建图片选择器\n      const photoSelectOptions = new photoAccessHelper.PhotoSelectOptions();\n      photoSelectOptions.MIMEType = photoAccessHelper.PhotoViewMIMETypes.IMAGE_TYPE;\n      photoSelectOptions.maxSelectNumber = 1;\n      \n      const photoViewPicker = new photoAccessHelper.PhotoViewPicker();\n      \n      try {\n        const photoSelectResult = await photoViewPicker.select(photoSelectOptions);\n        \n        if (photoSelectResult && photoSelectResult.photoUris && photoSelectResult.photoUris.length > 0) {\n          const selectedUri = photoSelectResult.photoUris[0];\n          Logger.info(`Selected image: ${selectedUri}`);\n          \n          // 设置图片 URI\n          this.imageUri = selectedUri;\n          this.hasImage = true;\n          this.showResult = true;\n          \n          // 执行 OCR 识别\n          await this.performOCR(selectedUri);\n        } else {\n          Logger.info('No image selected');\n        }\n      } catch (err) {\n        Logger.error('Photo selection cancelled or failed', err);\n        ToastHelper.showWarning('未选择图片');\n      }\n      \n    } catch (error) {\n      Logger.error('Failed to select from album', error);\n      ToastHelper.showError('选择图片失败');\n    }\n  }\n\n  /**\n   * 导入到计算器\n   */\n  importToCalculator() {\n    if (this.recognizedLatex) {\n      try {\n        // 将 LaTeX 公式设置到计算器输入\n        this.calculatorInput = this.recognizedLatex;\n        \n        // 显示成功提示\n        ToastHelper.showSuccess('已导入到计算器');\n        \n        // 跳转到计算器页面\n        router.back();\n        \n        Logger.info(`Imported to calculator: ${this.recognizedLatex}`);\n      } catch (error) {\n        Logger.error('Failed to import to calculator', error);\n        ToastHelper.showError('导入失败');\n      }\n    }\n  }\n\n  /**\n   * 重置\n   */\n  resetUpload() {\n    this.hasImage = false;\n    this.recognizedLatex = '';\n    this.isProcessing = false;\n    this.imageUri = '';\n    this.showResult = false;\n  }\n}\n\n\n\n```","tool_call_id":"tool_23268154-d2f3-42a6-8b23-231272243781","name":"read_file"},{"role":"assistant","content":"","tool_calls":[{"type":"function","id":"tool_74de9c8c-2c3f-4ef5-a432-a37740b66fc4","index":0,"function":{"name":"read_file","arguments":"{\"target_file\":\"/Users/wangyiqiu/DevEcoStudioProjects/hello_my_worldMyApplication/entry/src/main/ets/pages/CameraPage.ets\"}"}}]},{"role":"tool","content":"```\n/**\n * 相机拍照页面\n * 实现相机预览和拍照功能\n */\nimport { Logger } from '../utils/Logger';\nimport { ToastHelper } from '../utils/ToastHelper';\nimport { camera } from '@kit.CameraKit';\nimport { image } from '@kit.ImageKit';\nimport { BusinessError } from '@kit.BasicServicesKit';\nimport { router } from '@kit.ArkUI';\nimport { fileIo as fs } from '@kit.CoreFileKit';\nimport { common } from '@kit.AbilityKit';\nimport { abilityAccessCtrl, Permissions } from '@kit.AbilityKit';\n\n@Entry\n@Component\nstruct CameraPage {\n  private xComponentController: XComponentController = new XComponentController();\n  private surfaceId: string = '';\n  private cameraManager?: camera.CameraManager;\n  private cameraDevice?: camera.CameraDevice;\n  private cameraInput?: camera.CameraInput;\n  private previewOutput?: camera.PreviewOutput;\n  private photoOutput?: camera.PhotoOutput;\n  private cameraSession?: camera.PhotoSession;\n  \n  @State isInitialized: boolean = false;\n  @State isTakingPhoto: boolean = false;\n  @State errorMessage: string = '';\n  @State isReturning: boolean = false;\n\n  async aboutToAppear() {\n    Logger.info('CameraPage loaded');\n    try {\n      // 请求相机权限\n      const hasPermission = await this.requestCameraPermission();\n      if (!hasPermission) {\n        Logger.warn('Camera permission not granted');\n      }\n    } catch (error) {\n      Logger.error('Error in aboutToAppear', error);\n    }\n  }\n\n  aboutToDisappear() {\n    Logger.info('CameraPage aboutToDisappear');\n    // 异步释放，不阻塞页面销毁\n    this.releaseCamera().catch((err: BusinessError) => {\n      Logger.error('Error releasing camera in aboutToDisappear', err);\n    });\n  }\n\n  /**\n   * 处理返回键\n   */\n  onBackPress(): boolean {\n    Logger.info('CameraPage onBackPress');\n    // 异步释放相机资源\n    this.releaseCamera().catch((err: BusinessError) => {\n      Logger.error('Error releasing camera in onBackPress', err);\n    });\n    // 返回 false 允许默认返回行为\n    return false;\n  }\n\n  build() {\n    Stack() {\n      // 相机预览区域\n      XComponent({\n        id: 'camera_preview',\n        type: XComponentType.SURFACE,\n        controller: this.xComponentController\n      })\n        .onLoad(() => {\n          try {\n            this.surfaceId = this.xComponentController.getXComponentSurfaceId();\n            Logger.info(`XComponent loaded, surfaceId: ${this.surfaceId}`);\n            // 异步初始化相机，不阻塞 UI\n            this.initCamera().catch((err: BusinessError) => {\n              Logger.error('Failed to init camera in onLoad', err);\n            });\n          } catch (error) {\n            Logger.error('Error in XComponent onLoad', error);\n          }\n        })\n        .width('100%')\n        .height('100%')\n\n      // 顶部控制栏\n      Column() {\n        Row() {\n          // 返回按钮\n          Button() {\n            Text('✕')\n              .fontSize(24)\n              .fontColor('#FFFFFF')\n          }\n          .width(48)\n          .height(48)\n          .backgroundColor('rgba(0, 0, 0, 0.3)')\n          .borderRadius(24)\n          .onClick(() => {\n            if (this.isReturning) {\n              Logger.info('Already returning, ignoring click');\n              return;\n            }\n            \n            this.isReturning = true;\n            Logger.info('Back button clicked');\n            \n            // 设置一个最大等待时间，确保一定会返回\n            const forceBackTimeout = setTimeout(() => {\n              Logger.warn('Force back after timeout');\n              router.back();\n            }, 500);\n            \n            // 尝试正常返回\n            try {\n              router.back();\n              clearTimeout(forceBackTimeout);\n            } catch (error) {\n              Logger.error('Error during router.back()', error);\n              clearTimeout(forceBackTimeout);\n              // 即使出错也强制返回\n              router.back();\n            }\n          })\n\n          Blank()\n\n          // 闪光灯按钮（占位）\n          Button() {\n            Text('⚡')\n              .fontSize(20)\n              .fontColor('#FFFFFF')\n          }\n          .width(48)\n          .height(48)\n          .backgroundColor('rgba(0, 0, 0, 0.3)')\n          .borderRadius(24)\n          .onClick(() => {\n            ToastHelper.show('闪光灯功能开发中');\n          })\n        }\n        .width('100%')\n        .padding({ left: 16, right: 16, top: 16 })\n      }\n      .width('100%')\n      .alignItems(HorizontalAlign.Start)\n\n      // 底部拍照按钮\n      Column() {\n        if (this.errorMessage) {\n          Column() {\n            Text(this.errorMessage)\n              .fontSize(14)\n              .fontColor('#FF4D4F')\n              .textAlign(TextAlign.Center)\n              .padding(16)\n              .backgroundColor('rgba(255, 255, 255, 0.9)')\n              .borderRadius(8)\n              .margin({ bottom: 20 })\n          }\n        }\n\n        // 拍照按钮\n        Button() {\n          if (this.isTakingPhoto) {\n            LoadingProgress()\n              .width(32)\n              .height(32)\n              .color('#FFFFFF')\n          } else {\n            Column() {\n              // 外圈\n              Column()\n                .width(70)\n                .height(70)\n                .backgroundColor('#FFFFFF')\n                .borderRadius(35)\n                .border({ width: 4, color: 'rgba(255, 255, 255, 0.5)' })\n            }\n            .width(80)\n            .height(80)\n            .justifyContent(FlexAlign.Center)\n          }\n        }\n        .width(80)\n        .height(80)\n        .backgroundColor('transparent')\n        .enabled(this.isInitialized && !this.isTakingPhoto)\n        .onClick(() => {\n          this.takePhoto();\n        })\n\n        Text('点击拍照')\n          .fontSize(14)\n          .fontColor('#FFFFFF')\n          .margin({ top: 12 })\n      }\n      .width('100%')\n      .padding({ bottom: 40 })\n      .alignItems(HorizontalAlign.Center)\n    }\n    .width('100%')\n    .height('100%')\n    .backgroundColor('#000000')\n    .alignContent(Alignment.TopStart)\n  }\n\n  /**\n   * 请求相机权限\n   */\n  async requestCameraPermission(): Promise<boolean> {\n    try {\n      const atManager = abilityAccessCtrl.createAtManager();\n      const permissions: Array<Permissions> = ['ohos.permission.CAMERA'];\n      \n      const grantStatus = await atManager.checkAccessToken(\n        (getContext(this) as common.UIAbilityContext).applicationInfo.accessTokenId,\n        permissions[0]\n      );\n      \n      if (grantStatus === abilityAccessCtrl.GrantStatus.PERMISSION_GRANTED) {\n        Logger.info('Camera permission already granted');\n        return true;\n      }\n      \n      // 请求权限\n      const result = await atManager.requestPermissionsFromUser(\n        getContext(this) as common.UIAbilityContext,\n        permissions\n      );\n      \n      if (result.authResults[0] === abilityAccessCtrl.GrantStatus.PERMISSION_GRANTED) {\n        Logger.info('Camera permission granted');\n        return true;\n      } else {\n        Logger.error('Camera permission denied');\n        this.errorMessage = '相机权限被拒绝，无法使用相机';\n        ToastHelper.showError('需要相机权限才能拍照');\n        return false;\n      }\n    } catch (error) {\n      Logger.error('Failed to request camera permission', error);\n      this.errorMessage = '权限请求失败';\n      return false;\n    }\n  }\n\n  /**\n   * 初始化相机\n   */\n  async initCamera() {\n    try {\n      Logger.info('Initializing camera...');\n\n      // 获取相机管理器\n      this.cameraManager = camera.getCameraManager(getContext(this) as common.UIAbilityContext);\n      if (!this.cameraManager) {\n        throw new Error('Failed to get camera manager');\n      }\n\n      // 获取相机设备列表\n      const cameras = this.cameraManager.getSupportedCameras();\n      if (!cameras || cameras.length === 0) {\n        throw new Error('No camera device found');\n      }\n\n      // 选择后置摄像头（如果有的话）\n      this.cameraDevice = cameras.find(cam => cam.cameraPosition === camera.CameraPosition.CAMERA_POSITION_BACK) || cameras[0];\n      Logger.info(`Selected camera: ${this.cameraDevice.cameraId}`);\n\n      // 创建相机输入\n      this.cameraInput = this.cameraManager.createCameraInput(this.cameraDevice);\n      await this.cameraInput.open();\n\n      // 获取支持的输出能力（使用新 API）\n      const cameraOutputCapability = this.cameraManager.getSupportedOutputCapability(\n        this.cameraDevice,\n        camera.SceneMode.NORMAL_PHOTO\n      );\n      \n      // 创建预览输出\n      const previewProfile = cameraOutputCapability.previewProfiles[0];\n      this.previewOutput = this.cameraManager.createPreviewOutput(previewProfile, this.surfaceId);\n\n      // 创建拍照输出\n      const photoProfile = cameraOutputCapability.photoProfiles[0];\n      this.photoOutput = this.cameraManager.createPhotoOutput(photoProfile);\n\n      // 创建会话（使用新 API）\n      this.cameraSession = this.cameraManager.createSession(camera.SceneMode.NORMAL_PHOTO) as camera.PhotoSession;\n      this.cameraSession.beginConfig();\n\n      // 添加输入和输出\n      this.cameraSession.addInput(this.cameraInput);\n      this.cameraSession.addOutput(this.previewOutput);\n      this.cameraSession.addOutput(this.photoOutput);\n\n      // 提交配置并启动会话\n      await this.cameraSession.commitConfig();\n      await this.cameraSession.start();\n\n      this.isInitialized = true;\n      Logger.info('Camera initialized successfully');\n\n    } catch (error) {\n      const err = error as BusinessError;\n      Logger.error('Failed to initialize camera', err);\n      this.errorMessage = `相机初始化失败: ${err.message}`;\n      \n      ToastHelper.showError('相机初始化失败，请检查权限设置');\n    }\n  }\n\n  /**\n   * 拍照\n   */\n  async takePhoto() {\n    if (!this.photoOutput || !this.isInitialized) {\n      ToastHelper.showWarning('相机未就绪');\n      return;\n    }\n\n    try {\n      this.isTakingPhoto = true;\n      Logger.info('Taking photo...');\n\n      // 设置拍照回调\n      this.photoOutput.on('photoAvailable', async (errCode: BusinessError, photo: camera.Photo) => {\n        if (errCode || !photo) {\n          Logger.error('Photo capture failed', errCode);\n          this.isTakingPhoto = false;\n          ToastHelper.showError('拍照失败');\n          return;\n        }\n\n        try {\n          Logger.info('Photo captured, processing...');\n\n          // 获取图片组件\n          const imageObj = photo.main;\n          const width = imageObj.size.width;\n          const height = imageObj.size.height;\n          const format = image.ImageFormat.JPEG;\n          const capacity = 1;\n          \n          const imageReceiver = image.createImageReceiver(width, height, format, capacity);\n\n          // 读取图片数据\n          const imageBuffer = await imageReceiver.readNextImage();\n          const imageComponent = await imageBuffer.getComponent(image.ComponentType.JPEG);\n          \n          if (!imageComponent || !imageComponent.byteBuffer) {\n            throw new Error('Failed to get image data');\n          }\n\n          // 保存图片到临时文件\n          const context = getContext(this) as common.UIAbilityContext;\n          const cacheDir = context.cacheDir;\n          const fileName = `photo_${Date.now()}.jpg`;\n          const filePath = `${cacheDir}/${fileName}`;\n\n          const file = fs.openSync(filePath, fs.OpenMode.CREATE | fs.OpenMode.READ_WRITE);\n          fs.writeSync(file.fd, imageComponent.byteBuffer);\n          fs.closeSync(file);\n\n          Logger.info(`Photo saved to: ${filePath}`);\n\n          // 释放资源\n          await imageBuffer.release();\n          await imageReceiver.release();\n\n          // 返回到 OCR 页面并传递图片路径\n          router.back({\n            url: 'pages/ImageOCRPage',\n            params: {\n              imageUri: `file://${filePath}`,\n              fromCamera: true\n            }\n          });\n\n          ToastHelper.showSuccess('拍照成功');\n\n        } catch (err) {\n          Logger.error('Failed to process photo', err);\n          this.isTakingPhoto = false;\n          ToastHelper.showError('图片处理失败');\n        }\n      });\n\n      // 触发拍照\n      const photoSettings: camera.PhotoCaptureSetting = {\n        quality: camera.QualityLevel.QUALITY_LEVEL_HIGH,\n        rotation: camera.ImageRotation.ROTATION_0\n      };\n      await this.photoOutput.capture(photoSettings);\n\n    } catch (error) {\n      Logger.error('Failed to take photo', error);\n      this.isTakingPhoto = false;\n      ToastHelper.showError('拍照失败');\n    }\n  }\n\n  /**\n   * 释放相机资源\n   */\n  async releaseCamera() {\n    try {\n      Logger.info('Releasing camera resources...');\n\n      // 使用 Promise.race 添加超时保护\n      const releasePromise = this.doReleaseCamera();\n      const timeoutPromise = new Promise<void>((_resolve: (value: void) => void, reject: (reason: Error) => void) => {\n        setTimeout(() => reject(new Error('Release timeout')), 2000);\n      });\n\n      try {\n        await Promise.race<void>([releasePromise, timeoutPromise]);\n        Logger.info('Camera resources released successfully');\n      } catch (timeoutError) {\n        Logger.error('Camera release timeout, forcing release', timeoutError);\n        // 超时也继续，不阻塞返回\n      }\n    } catch (error) {\n      Logger.error('Failed to release camera', error);\n      // 即使失败也不阻塞\n    }\n  }\n\n  /**\n   * 实际释放相机资源的方法\n   */\n  private async doReleaseCamera() {\n    try {\n      if (this.cameraSession) {\n        try {\n          await this.cameraSession.stop();\n        } catch (e) {\n          Logger.error('Failed to stop session', e);\n        }\n        try {\n          await this.cameraSession.release();\n        } catch (e) {\n          Logger.error('Failed to release session', e);\n        }\n        this.cameraSession = undefined;\n      }\n\n      if (this.photoOutput) {\n        try {\n          await this.photoOutput.release();\n        } catch (e) {\n          Logger.error('Failed to release photoOutput', e);\n        }\n        this.photoOutput = undefined;\n      }\n\n      if (this.previewOutput) {\n        try {\n          await this.previewOutput.release();\n        } catch (e) {\n          Lo