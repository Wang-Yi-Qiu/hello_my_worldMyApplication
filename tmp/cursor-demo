                  "value": "{\"file_path\":\"entry/src/main/ets/pages/CalculatorPage.ets\",\"old_string\":\"      case '!':\\n        // 阶乘 - 暂不支持，显示提示\\n        promptAction.showToast({ message: '阶乘功能暂未实现' });\\n        break;\\n      \\n      case 'rad':\\n        // 弧度模式切换 - 显示提示\\n        promptAction.showToast({ message: '当前为弧度模式' });\\n        break;\",\"new_string\":\"      case '!':\\n        // 阶乘\\n        this.expression += '!';\\n        break;\\n      \\n      case 'rad':\\n      case 'deg':\\n        // 角度/弧度模式切换\\n        this.angleMode = this.angleMode === 'DEG' ? 'RAD' : 'DEG';\\n        promptAction.showToast({ message: `已切换到${this.angleMode === 'DEG' ? '角度' : '弧度'}模式` });\\n        break;\\n      \\n      case 'asin':\\n      case 'acos':\\n      case 'atan':\\n        // 反三角函数\\n        this.expression += value + '(';\\n        break;\\n      \\n      case 'sinh':\\n      case 'cosh':\\n      case 'tanh':\\n        // 双曲函数\\n        this.expression += value + '(';\\n        break;\\n      \\n      case 'asinh':\\n      case 'acosh':\\n      case 'atanh':\\n        // 反双曲函数\\n        this.expression += value + '(';\\n        break;\\n      \\n      case 'P':\\n        // 排列\\n        this.expression += 'P(';\\n        break;\\n      \\n      case 'C':\\n        // 组合\\n        this.expression += 'C(';\\n        break;\\n      \\n      case 'abs':\\n        // 绝对值\\n        this.expression += 'abs(';\\n        break;\"}"
